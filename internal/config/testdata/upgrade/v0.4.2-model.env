# A deployment of v0.4.2, the latest release, with a model: every variable that
# release reads, set to a value inside the range its README gives. v0.4.2
# accepts it.
DIALLAK_TOKEN_FILE=@TOKEN_FILE@
DIALLAK_GUILD_ID=123456789012345678
DIALLAK_CORPUS_DIR=/srv/diallak/corpus
DIALLAK_MODEL_BASE_URL=https://gateway.example.org/v1
DIALLAK_MODEL_ALIAS=docs-answer
DIALLAK_MODEL_POLICY=docs-guardrails/v1
DIALLAK_MODEL_KEY_FILE=@KEY_FILE@
DIALLAK_SUPPORT_CHANNEL=#help
DIALLAK_HEALTH_ADDR=127.0.0.1:9090
DIALLAK_TOP_PASSAGES=10
DIALLAK_MIN_SCORE=1
DIALLAK_QUESTION_MAX_CHARS=500
DIALLAK_EXCERPT_CHARS=1000
DIALLAK_REPLY_MAX_CHARS=2000
DIALLAK_MAX_CONCURRENT_ASKS=64
DIALLAK_ASK_TIMEOUT=10m
DIALLAK_MODEL_TIMEOUT=5m
DIALLAK_SOURCE_LINK_TEMPLATE=https://github.com/{repository}/blob/{revision}/{path}?plain=1
