# A deployment of v0.1.2 without a model: every variable that release reads,
# set to a value inside the range its README gave. v0.1.2 accepts it.
DIALLAK_TOKEN_FILE=@TOKEN_FILE@
DIALLAK_GUILD_ID=123456789012345678
DIALLAK_CORPUS_DIR=/srv/diallak/corpus
DIALLAK_SUPPORT_CHANNEL=#help
DIALLAK_HEALTH_ADDR=0.0.0.0:8080
DIALLAK_TOP_PASSAGES=5
DIALLAK_MIN_SCORE=0.35
DIALLAK_QUESTION_MAX_CHARS=400
DIALLAK_EXCERPT_CHARS=300
DIALLAK_REPLY_MAX_CHARS=1800
DIALLAK_MAX_CONCURRENT_ASKS=8
DIALLAK_ASK_TIMEOUT=90s
DIALLAK_MODEL_TIMEOUT=30s
DIALLAK_SOURCE_LINK_TEMPLATE=https://git.example.org/{repository}/src/{revision}/{path}
