# A deployment of v0.1.2 whose source link template has a placeholder in the
# host. v0.1.2 accepts it; since v0.2.0 the host is written literally
# (d87dd04, Migration footer).
DIALLAK_TOKEN_FILE=@TOKEN_FILE@
DIALLAK_GUILD_ID=123456789012345678
DIALLAK_CORPUS_DIR=/srv/diallak/corpus
DIALLAK_SOURCE_LINK_TEMPLATE=https://{repository}.example.org/{revision}/{path}
