# Generated by Praetor from declared project commands; execution is unverified.
-include .config/praetor/engine.mk
include .config/golangci-lint.mk
# Praetor ships one binary under two names; resolve whichever is installed.
PRAETORCTL ?= $(shell command -v praetorctl 2>/dev/null || command -v standardsctl 2>/dev/null || echo praetorctl)
.PHONY: all verify-all compile-context compile-context-verify caveman-sources audit build test verify-lints golangci-lint-install

all: build

verify-all: compile-context-verify caveman-sources audit verify-lints test

compile-context:
	@$(PRAETORCTL) compile-context

compile-context-verify:
	@$(PRAETORCTL) compile-context --verify

caveman-sources:
	@$(PRAETORCTL) caveman check --configured-sources

audit:
	@$(PRAETORCTL) audit

test: build
	@exec 'go' 'test' '-v' '-race' './...'

build:
	@exec 'go' 'build' '-v' './...'

# Repository-owned: the CI lint step, run locally by verify-all and the
# pre-push hook and in CI through this same target. The linter comes from
# PATH or GOLANGCI_LINT; a missing linter or another version fails.
GOLANGCI_LINT ?= $(shell command -v golangci-lint 2>/dev/null)

verify-lints:
	@if [ -z '$(GOLANGCI_LINT)' ]; then echo 'verify-lints: golangci-lint $(GOLANGCI_LINT_VERSION) not found; install it or set GOLANGCI_LINT (make golangci-lint-install)' >&2; exit 1; fi
	@'$(GOLANGCI_LINT)' version | grep --fixed-strings --quiet 'version $(GOLANGCI_LINT_VERSION) ' || { echo 'verify-lints: $(GOLANGCI_LINT) is not golangci-lint $(GOLANGCI_LINT_VERSION) (.config/golangci-lint.mk)' >&2; exit 1; }
	@python3 -I tools/ci/lint_scan.py --golangci-lint '$(GOLANGCI_LINT)' --self-test
	@python3 -I tools/ci/lint_scan.py --golangci-lint '$(GOLANGCI_LINT)'

# Downloads the pinned linux-amd64 release into GOLANGCI_LINT_DIR and checks
# its checksum; CI runs this before verify-lints.
GOLANGCI_LINT_DIR ?= .cache/golangci-lint
golangci_lint_name = golangci-lint-$(GOLANGCI_LINT_VERSION)-linux-amd64

golangci-lint-install:
	@mkdir -p '$(GOLANGCI_LINT_DIR)'
	@curl --fail --silent --show-error --location --proto '=https' --max-time 60 --output '$(GOLANGCI_LINT_DIR)/golangci-lint.tar.gz' 'https://github.com/golangci/golangci-lint/releases/download/v$(GOLANGCI_LINT_VERSION)/$(golangci_lint_name).tar.gz'
	@echo '$(GOLANGCI_LINT_SHA256)  $(GOLANGCI_LINT_DIR)/golangci-lint.tar.gz' | sha256sum --check --strict
	@tar -xzf '$(GOLANGCI_LINT_DIR)/golangci-lint.tar.gz' -C '$(GOLANGCI_LINT_DIR)' '$(golangci_lint_name)/golangci-lint'
	@echo '$(GOLANGCI_LINT_DIR)/$(golangci_lint_name)/golangci-lint'
